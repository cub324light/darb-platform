# ─── متغيّرات البيئة لمنصّة درب ───
# انسخ هذا الملف إلى .env.local للتطوير، وأضف القيم في Vercel للإنتاج.
# الخدمات التحليلية اختيارية: بدون مفتاح لا يُحمّل شيء (آمن).

# ── Firebase Admin (خادمي — سرّي) ──
# JSON كامل لحساب الخدمة (سطر واحد)
FIREBASE_SERVICE_ACCOUNT=

# ── الذكاء الاصطناعي (دويرب) ──
GROQ_API_KEY=

# ── Resend — إرسال البريد (اختياري) ──
# مفتاح API من resend.com → API Keys (يبدأ بـ re_)
RESEND_API_KEY=
# المُرسِل الافتراضي. بدون نطاق متحقَّق استخدم onboarding@resend.dev (يرسل لإيميلك فقط).
# مع نطاقك المتحقَّق: "درب <no-reply@your-domain.com>"
RESEND_FROM=

# ── لوحة الإدارة ──
ADMIN_PASS=

# ── Sentry — رصد الأخطاء (ضروري) ──
# DSN عام (مضبوط أصلاً كقيمة افتراضية في الكود — يعمل بدون ضبط).
# اضبطه هنا فقط لو غيّرت المشروع:
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
# لرفع خرائط المصدر تلقائياً وقت البناء (اختياري — للحصول على أسطر واضحة في التتبّع):
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# ── Microsoft Clarity — خرائط حرارية وتسجيل الجلسات ──
# معرّف المشروع من clarity.microsoft.com
NEXT_PUBLIC_CLARITY_ID=

# ── PostHog — تحليلات المنتج (اختياري) ──
# مفتاح المشروع من PostHog → Project Settings
NEXT_PUBLIC_POSTHOG_KEY=
# الخادم (اختياري): مشروع درب في منطقة EU، الافتراضي https://eu.i.posthog.com
NEXT_PUBLIC_POSTHOG_HOST=

rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // ملفات التحليل: كل مستخدم يكتب/يقرأ داخل مجلده فقط، وبحد ١٥ ميجابايت
    // وأنواع مدعومة (PDF / DOCX / TXT). لا قراءة عبر المستخدمين.
    match /analyses/{uid}/{fileName} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if request.auth != null
        && request.auth.uid == uid
        && request.resource.size < 15 * 1024 * 1024
        && (
          request.resource.contentType == 'application/pdf'
          || request.resource.contentType == 'application/vnd.openxmlformats-officedocument.wordprocessingml.document'
          || request.resource.contentType.matches('text/.*')
        );
    }

    // كل شيء آخر: ممنوع
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}

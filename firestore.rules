rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // كل مستخدم يقرأ ويكتب في مستنده فقط (بعد تسجيل الدخول).
    // لوحة الأدمن تقرأ الجميع عبر Admin SDK من السيرفر (تتجاوز هذه القواعد).
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
      match /friends/{fid} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }

    // الإعلانات الرسمية — قراءة للجميع المسجّلين، كتابة من الخادم فقط (Admin SDK)
    match /announcements/{id} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // رسائل المجلس — القراءة والكتابة للمسجّلين
    // كل رسالة: { uid, name, content, createdAt }
    match /chats/{groupId}/messages/{msgId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.content is string
        && request.resource.data.content.size() > 0
        && request.resource.data.content.size() <= 1000;
    }

    // كل مجموعة أخرى: ممنوعة بالكامل
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

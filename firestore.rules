rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ───── RBAC helpers ─────
    // الدور مصدره custom claims (يضبطها الخادم عبر Admin SDK).
    // المالك يُعرَّف بالإيميل (bootstrap) فلا يُحبَس خارجاً أبداً.
    function signedIn() { return request.auth != null; }
    function roleClaim() { return request.auth.token.role; }
    function isOwner() {
      return signedIn() && (
        request.auth.token.email == 'cublight231@gmail.com' ||
        roleClaim() == 'owner'
      );
    }
    function isAdmin() { return signedIn() && (isOwner() || roleClaim() == 'admin'); }
    function isStaff() { return signedIn() && (isAdmin() || roleClaim() == 'moderator'); }

    // H1: الحظر مفروض على القواعد — المحظور لا يكتب (يقرأ وثيقته لمعرفة blocked).
    function notBlocked() {
      return !( exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.blocked == true );
    }

    // Each user can read/write only their own document — أو الطاقم يقرأ أي مستخدم.
    // الحقول الإدارية (role/plan/blocked/blockUntil) لا تُكتب من العميل أبداً —
    // تُضبط عبر Admin SDK فقط (يتجاوز هذه القواعد). يمنع رفع الباقة ذاتياً أو فكّ الحظر.
    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isStaff());

      allow create: if request.auth.uid == uid
        && !('role' in request.resource.data)
        && !('plan' in request.resource.data)
        && !('blocked' in request.resource.data)
        && !('blockUntil' in request.resource.data)
        && !('referredBy' in request.resource.data)
        && !('referralCount' in request.resource.data)
        && !('pendingRefReward' in request.resource.data)
        && !('rp' in request.resource.data)
        && !('winStreak' in request.resource.data)
        && !('peakRp' in request.resource.data)
        && !('arenaWins' in request.resource.data)
        && !('arenaLosses' in request.resource.data);

      allow update: if request.auth.uid == uid
        && ( !('role' in request.resource.data)
             || request.resource.data.role == resource.data.role )
        && ( !('plan' in request.resource.data)
             || request.resource.data.plan == resource.data.plan )
        && ( !('blocked' in request.resource.data)
             || request.resource.data.blocked == resource.data.blocked )
        && ( !('blockUntil' in request.resource.data)
             || request.resource.data.blockUntil == resource.data.blockUntil )
        // RP/الرتبة وإحصاءات الأرينا تُضبط عبر الخادم فقط (Admin SDK) —
        // يمنع رفع الرتبة ذاتياً أو تزوير سجلّ الانتصارات.
        && ( !('rp' in request.resource.data)
             || request.resource.data.rp == resource.data.get('rp', 0) )
        && ( !('winStreak' in request.resource.data)
             || request.resource.data.winStreak == resource.data.get('winStreak', 0) )
        && ( !('peakRp' in request.resource.data)
             || request.resource.data.peakRp == resource.data.get('peakRp', 0) )
        && ( !('arenaWins' in request.resource.data)
             || request.resource.data.arenaWins == resource.data.get('arenaWins', 0) )
        && ( !('arenaLosses' in request.resource.data)
             || request.resource.data.arenaLosses == resource.data.get('arenaLosses', 0) )
        // حقول الإحالة تُضبط عبر الخادم فقط (Admin SDK) — يمنع تضخيم العدّ/المكافأة ذاتياً
        && ( !('referredBy' in request.resource.data)
             || request.resource.data.referredBy == resource.data.get('referredBy', null) )
        && ( !('referralCount' in request.resource.data)
             || request.resource.data.referralCount == resource.data.get('referralCount', 0) )
        && ( !('pendingRefReward' in request.resource.data)
             || request.resource.data.pendingRefReward == resource.data.get('pendingRefReward', 0) );

      allow delete: if false; // الحذف عبر الخادم فقط (Admin SDK)

      // Friends subcollection
      match /friends/{fid} {
        allow read, write: if signedIn() && request.auth.uid == uid;
      }

      // حالة المحرّكات (ذاكرة/سجلّ الأحداث) — مزامنة على مستوى الكيان لصاحبها فقط.
      // خارج وثيقة المستخدم لتفادي حدّ 1MB ولدمج id/version عبر الأجهزة.
      match /engine/{docId} {
        allow read, write: if signedIn() && request.auth.uid == uid;
      }
    }

    // Official announcements: signed-in users read; writes only from server (Admin SDK)
    match /announcements/{id} {
      allow read: if signedIn();
      allow write: if false;
    }

    // وثيقة المهلة لكل مستخدم — تُكتب مع كل رسالة لفرض المهلة على الخادم.
    // H3: لا يُسمح بكتابة lastPostAt إلا بقيمة request.time (وقت الخادم الآن) —
    // فلا يستطيع عميل معدَّل «تقديم» المهلة بوضع قيمة قديمة لتجاوز الانتظار.
    match /rate/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if signedIn() && request.auth.uid == uid
        && request.resource.data.lastPostAt == request.time;
    }

    // Council chat messages: signed-in users read and post their own messages;
    // الطاقم يقدر يحذف أي رسالة (إشراف).
    // الشروط على الخادم (دفاع متعدّد الطبقات مع فلتر العميل):
    //  • البريد موثّق (email_verified) — يطابق بوابة العميل.
    //  • منع وسائل التواصل: روابط، بريد/معرّفات (@)، أرقام طويلة (هواتف). (?s) ليشمل الأسطر.
    //  • مهلة بين الرسائل: تُحدَّث rate/{uid} إلى request.time في نفس الدفعة،
    //    وتُرفض الرسالة إن كانت آخر رسالة أحدث من ٤ ثوانٍ.
    match /chats/{groupId}/messages/{msgId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && notBlocked()
        && request.auth.token.email_verified == true
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.content is string
        && request.resource.data.content.size() > 0
        && request.resource.data.content.size() <= 1000
        && !request.resource.data.content.matches('(?s).*(https?://|www[.]|[@]|[0-9]{7,}).*')
        && getAfter(/databases/$(database)/documents/rate/$(request.auth.uid)).data.lastPostAt == request.time
        && ( !exists(/databases/$(database)/documents/rate/$(request.auth.uid))
             || get(/databases/$(database)/documents/rate/$(request.auth.uid)).data.lastPostAt < request.time - duration.value(4, 's') );
      allow delete: if isStaff();
    }

    // بلاغات المجلس (C1): تُنشأ من الخادم فقط (Admin SDK) عبر mode=reportMessage،
    // الذي يشتق المُبلَّغ عنه/الاسم/المحتوى من الرسالة الحقيقية — فلا يستطيع
    // العميل تلفيق بلاغ عن ضحية أو حقن محتوى مزوّر. الطاقم يقرأ/يحدّث/يحذف.
    match /reports/{id} {
      allow create: if false;
      allow read, update, delete: if isStaff();
    }

    // سجلّ إجراءات الإشراف (تدقيق): الطاقم يقرأ؛ الكتابة من الخادم فقط (Admin SDK).
    match /mod_actions/{id} {
      allow read: if isStaff();
      allow write: if false;
    }

    // ───── الأرينا 1v1 ─────
    // طابور المطابقة: كل الكتابة عبر الخادم فقط (Admin SDK) لمنع التلاعب
    // والمباريات الوهمية. صاحب التذكرة يقرأ تذكرته فقط (لرصد المطابقة فوراً).
    match /matchQueue/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if false;
    }

    // المباريات: يقرؤها لاعباها فقط (الاسم/الرتبة/الأسئلة/النتيجة). الكتابة
    // من الخادم فقط (إنشاء/حسم/تطبيق RP) — لا يكتب العميل أي نتيجة.
    match /matches/{matchId} {
      allow read: if signedIn() && request.auth.uid in resource.data.playerUids;
      allow write: if false;
      // مفتاح الإجابات وأي بيانات خاصة — لا يقرؤها العميل إطلاقاً
      match /private/{doc} {
        allow read, write: if false;
      }
    }

    // ───── قاعدة المعرفة (Knowledge Base) ─────
    // المصادر: قراءة للطاقم فقط (إدارة)، الكتابة من الخادم فقط (Admin SDK).
    match /kb_sources/{id} {
      allow read: if isStaff();
      allow write: if false;
    }
    // مدخلات المعرفة: يقرؤها أي مسجّل (تأريض دويرب offline-first بعد التخزين)،
    // الكتابة من الخادم فقط (لا يلوّث العميل المعرفة).
    match /kb_entries/{id} {
      allow read: if signedIn();
      allow write: if false;
    }
    // سجلّ نسخ المعرفة وسجلّ التدقيق: قراءة للطاقم، كتابة من الخادم فقط.
    match /kb_versions/{id} {
      allow read: if isStaff();
      allow write: if false;
    }
    match /audit_log/{id} {
      allow read: if isStaff();
      allow write: if false;
    }

    // عدّادات تحديد المعدّل الدائمة — من الخادم فقط (Admin SDK)، لا يلمسها العميل.
    match /rateLimits/{id} {
      allow read, write: if false;
    }

    // ───── سند: ربط وليّ الأمر ─────
    // المبدأ: الرمز بيد الطالب. هو من يُنشئه وهو من يفصل — فلا يُربط أحدٌ بحساب
    // طالبٍ من خلف ظهره. لذلك الربط كلّه يمرّ بالخادم (Admin SDK) لا بالعميل.

    // أرقام الاقتران: لا يقرؤها العميل إطلاقاً — لو قُرئت لأمكن سردُ الأرقام
    // الحيّة والارتباط بأي طالب. تُنشأ وتُستهلك على الخادم وحده.
    match /sanadCodes/{code} {
      allow read, write: if false;
    }

    // أولياءُ أمر الطالب. الإنشاء من الخادم فقط بعد التحقّق من رمزٍ حيّ.
    // والفصل حقٌّ للطرفين: الطالب يفصل وليَّه، والوليّ ينسحب.
    match /sanadLinks/{studentUid}/guardians/{guardianUid} {
      allow read:   if signedIn() && (request.auth.uid == studentUid || request.auth.uid == guardianUid);
      allow delete: if signedIn() && (request.auth.uid == studentUid || request.auth.uid == guardianUid);
      allow create, update: if false;
    }

    // فهرسُ أبناء الوليّ — ليجد ابنه من أي جهاز يدخل منه.
    match /sanadGuardians/{guardianUid}/children/{studentUid} {
      allow read, delete: if signedIn() && request.auth.uid == guardianUid;
      allow create, update: if false;
    }

    // ملخّصُ الطالب. يكتبه جهازُه وحده، ويقرؤه هو أو وليٌّ **مرتبطٌ فعلاً** —
    // الارتباط يُتحقَّق بوجود وثيقة الوليّ تحت الطالب، وتلك لا يكتبها إلا الخادم.
    // المحتوى نفسُه مُسقَطٌ في `sanad/digestDoc.ts` (قائمة سماح): لا محادثات
    // ولا دفتر ولا أخطاء مفصّلة — فحتى لو تسرّبت القراءة لم يتسرّب سرّ.
    match /sanadDigests/{studentUid} {
      allow read: if signedIn() && (
        request.auth.uid == studentUid
        || exists(/databases/$(database)/documents/sanadLinks/$(studentUid)/guardians/$(request.auth.uid))
      );
      allow write: if signedIn() && request.auth.uid == studentUid;
    }

    // ───── المحتوى التعليمي العام ─────
    // أسئلة القبول الشائعة، قوائم مرجعية، نصائح، بطاقات حقائق التحصيلي،
    // استراتيجيات المذاكرة، وقصص النجاح — تُعرض في صفحات عامة بدون تسجيل دخول
    // (/faq و/tahsili/flashcards و/success-stories)، فالقراءة عامة.
    // الكتابة من الخادم فقط (Admin SDK عبر scripts/seed-firestore.js).
    match /faq_general/{id} {
      allow read: if true;
      allow write: if false;
    }
    match /faq_qubool/{id} {
      allow read: if true;
      allow write: if false;
    }
    match /reference_lists/{id} {
      allow read: if true;
      allow write: if false;
    }
    match /tips/{id} {
      allow read: if true;
      allow write: if false;
    }
    match /tahsili_flashcards/{id} {
      allow read: if true;
      allow write: if false;
    }
    match /study_strategies/{id} {
      allow read: if true;
      allow write: if false;
    }
    match /success_stories/{id} {
      allow read: if true;
      allow write: if false;
    }

    // Everything else: denied
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

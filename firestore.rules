rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Each user can read/write only their own document
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;

      // Friends subcollection
      match /friends/{fid} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }

    // Official announcements: signed-in users read; writes only from server (Admin SDK)
    match /announcements/{id} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // Council chat messages: signed-in users read and post their own messages
    match /chats/{groupId}/messages/{msgId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.content is string
        && request.resource.data.content.size() > 0
        && request.resource.data.content.size() <= 1000;
    }

    // Everything else: denied
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
